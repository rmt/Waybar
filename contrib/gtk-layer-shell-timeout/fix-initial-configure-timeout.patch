+#include "integration-test-common.h"
+#include <wayland-client.h>
+
+static gboolean slow_callback_ran;
+
+static void slow_done(void *data, struct wl_callback *callback, uint32_t serial)
+{
+    (void)data;
+    (void)serial;
+    wl_callback_destroy(callback);
+    slow_callback_ran = TRUE;
+    // Simulate a slow application callback dispatched by the initial configure roundtrip.
+    g_usleep(1200000);
+}
+
+static const struct wl_callback_listener slow_listener = {
+    .done = slow_done,
+};
+
+static void queue_slow_callback(GtkWidget *widget, gpointer data)
+{
+    (void)widget;
+    (void)data;
+    struct wl_display *display = gdk_wayland_display_get_wl_display(gdk_display_get_default());
+    struct wl_callback *callback = wl_display_sync(display);
+    wl_callback_add_listener(callback, &slow_listener, NULL);
+}
+
+static void callback_0(void)
+{
+    EXPECT_MESSAGE(zwlr_layer_surface_v1 .configure);
+
+    GtkWindow *window = create_default_window();
+    // Queue the slow callback immediately before layer-shell starts its configure wait.
+    g_signal_connect(window, "map", G_CALLBACK(queue_slow_callback), NULL);
+    gtk_layer_init_for_window(window);
+    gtk_widget_show_all(GTK_WIDGET(window));
+
+    g_assert_true(slow_callback_ran);
+    // Receiving configure during a slow roundtrip must not unmap the window.
+    g_assert_true(gtk_widget_get_mapped(GTK_WIDGET(window)));
+}
+
+TEST_CALLBACKS(
+    callback_0,
+)
